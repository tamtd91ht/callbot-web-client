# mock = BFF dùng simulator in-memory (demo trọn luồng tạo phiên — không cần backend)
# real = BFF gọi callbot-service STG thật (C-03a):
#        - Danh sách/chi tiết/pause/resume/cancel phiên CŨ + xem records: CHẠY ĐƯỢC NGAY
#        - Tạo phiên client/nạp data/submit: chờ backend B8 deploy (UI báo CS_NOT_READY)
# real = trinh duyet goi THANG callbot-service stg (Network tab thay domain that)
# mock = BFF simulator in-memory, khong can backend
NEXT_PUBLIC_CALLBOT_MODE=mock
NEXT_PUBLIC_CALLBOT_BASE_URL=https://callbot-v2-stg.omicrm.com/call-bot

# Chi con y nghia voi mock mode
CALLBOT_MODE=mock

# API origin thật của callbot-service stg (domain call-bot-stg.omicrm.com là FRONTEND;
# origin API trích từ config SPA: callbot-v2-stg.omicrm.com)
CALLBOT_BASE_URL=https://callbot-v2-stg.omicrm.com/call-bot

# JWT đăng nhập OmiCRM stg — CÁCH CHÍNH: dán qua UI (nút "Token" trên thanh header, lưu
# localStorage, sửa được khi hết hạn). Env này chỉ là FALLBACK khi UI chưa có token.
# Lấy token: đăng nhập https://call-bot-stg.omicrm.com → DevTools → Network → copy header Authorization
CALLBOT_JWT=

# Socket gateway thật (C-03b — FE nối trực tiếp, không qua BFF)
NEXT_PUBLIC_SOCKET_URL=

# ===== mock tuning =====
MOCK_TICK_MS=2000
