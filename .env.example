# ============================================================================
# NEXT_PUBLIC_* BẮT BUỘC giữ tiền tố đó — trình duyệt phải đọc được 2 biến này.
#   real = trình duyệt gọi THẲNG callbot-service (Network tab thấy đúng domain thật)
#   mock = BFF simulator in-memory, demo trọn luồng tạo phiên, KHÔNG cần backend
# ============================================================================
NEXT_PUBLIC_CALLBOT_MODE=mock
NEXT_PUBLIC_CALLBOT_BASE_URL=https://callbot-v2-stg.omicrm.com/call-bot

# ===== Gateway danh mục cho màn Lên phiên (chỉ dùng ở real mode) =====
# Lấy đúng những API mà app OMICRM thật dùng cho luồng tạo phiên AutoCall
# (đối chiếu web-v2 constants/Domain.js + sagas/marketing/MarketingSaga.js getMktgOption).

# kịch bản callbot + giọng đọc (bot-accent)
NEXT_PUBLIC_CHATBOT_GATEWAY_URL=https://chatbot-gateway-v1-stg.omicrm.com
# đầu số (public_number_of_tenant/list_active)
NEXT_PUBLIC_PBX_GATEWAY_URL=https://pbx-v1-stg.omicrm.com
# mục đích cuộc gọi (call_transaction/purpose/get_list) — danh mục tenant tự định nghĩa
NEXT_PUBLIC_CDR_GATEWAY_URL=https://cdr-v1-stg.omicrm.com
# thẻ / nhóm khách hàng / loại hình (tag|contact-categories|business /search-all)
NEXT_PUBLIC_TENANT_CONFIG_URL=https://tenant-config-stg.omicrm.com
# prefix mã quốc gia (phone_prefix/get_all)
NEXT_PUBLIC_TENANT_GATEWAY_URL=https://tenant-v1-stg.omicrm.com

# Chỉ còn ý nghĩa với mock mode (BFF simulator chạy phía server)
CALLBOT_MODE=mock

# JWT gọi backend — CÁCH CHÍNH: dán qua UI (nút "Token" trên thanh header, lưu localStorage,
# sửa lại được khi hết hạn), KHÔNG cần điền vào đây.
# Lấy token: đăng nhập trang callbot → DevTools → Network → copy header Authorization.

# Socket gateway realtime — real mode nối socket.io namespace /call_bot (khớp socketConfig.event
# của app OMICRM đang chạy thật). Để trống thì dùng mặc định stg dưới đây.
# LƯU Ý: callbot-service publish event vào room = tenantId (không phải sessionId) nên FE tự lọc
# theo clientSessionId. Nối socket lỗi thì màn chi tiết tự rơi về poll 10s.
NEXT_PUBLIC_SOCKET_URL=https://socket-event-v1-stg.omicrm.com

# ===== mock tuning =====
# Nhịp tick của dispatcher mô phỏng (ms)
MOCK_TICK_MS=2000
