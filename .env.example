# mock  = BFF dùng simulator in-memory (mô phỏng đầy đủ vòng đời phiên — mặc định)
# real  = BFF proxy sang callbot-service thật (bật khi BE B8 xong)
CALLBOT_MODE=mock

# ===== chỉ dùng khi CALLBOT_MODE=real =====
CALLBOT_BASE_URL=http://localhost:8080/call-bot
CALLBOT_JWT=
# Socket gateway thật (real mode FE nối trực tiếp, không qua BFF) — ticket C-03
NEXT_PUBLIC_SOCKET_URL=

# ===== mock tuning =====
# 1 tick dispatcher mô phỏng (ms) — mặc định 2000
MOCK_TICK_MS=2000
